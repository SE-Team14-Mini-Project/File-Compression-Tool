if(NOT DEFINED HUF_EXECUTABLE OR NOT EXISTS "${HUF_EXECUTABLE}")
    message(FATAL_ERROR "HUF_EXECUTABLE must name the built CLI")
endif()
set(work "${CMAKE_CURRENT_BINARY_DIR}/overwrite-cli")
file(MAKE_DIRECTORY "${work}")
file(REMOVE "${work}/good.huf" "${work}/failed.out" "${work}/retry.out")
file(WRITE "${work}/input.bin" "AAAAABBBCC")
file(WRITE "${work}/existing.out" "KEEP_EXISTING_BYTES")
function(run_failure)
    execute_process(COMMAND "${HUF_EXECUTABLE}" ${ARGN} WORKING_DIRECTORY "${work}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${result}" STREQUAL "1")
        message(FATAL_ERROR "Expected operation failure (exit 1), got '${result}': ${output} ${error}")
    endif()
    if(output MATCHES "successful" OR error STREQUAL "")
        message(FATAL_ERROR "Failure must have a diagnostic and no success message")
    endif()
    file(GLOB temporary LIST_DIRECTORIES true "${work}/.team14-tmp-*" "${work}/.team14-io-check-*")
    if(temporary)
        message(FATAL_ERROR "Failure leaked temporary output: ${temporary}")
    endif()
endfunction()
file(SHA256 "${work}/input.bin" source_hash)
file(SHA256 "${work}/existing.out" sentinel_hash)
run_failure(compress input.bin existing.out)
run_failure(compress input.bin input.bin)
execute_process(COMMAND "${HUF_EXECUTABLE}" compress input.bin good.huf WORKING_DIRECTORY "${work}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not create valid archive: ${error}")
endif()
file(SHA256 "${work}/good.huf" archive_hash)
run_failure(decompress good.huf existing.out)
run_failure(decompress good.huf good.huf)
run_failure(decompress good.huf input.bin)
file(WRITE "${work}/bad.huf" "not an archive")
run_failure(decompress bad.huf failed.out)
if(EXISTS "${work}/failed.out")
    message(FATAL_ERROR "Failed decoding published a final output")
endif()
execute_process(COMMAND "${HUF_EXECUTABLE}" decompress good.huf retry.out WORKING_DIRECTORY "${work}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Valid retry failed: ${error}")
endif()
file(SHA256 "${work}/retry.out" retry_hash)
file(SHA256 "${work}/input.bin" source_after)
file(SHA256 "${work}/good.huf" archive_after)
file(SHA256 "${work}/existing.out" sentinel_after)
if(NOT source_hash STREQUAL source_after OR NOT source_hash STREQUAL retry_hash OR
   NOT archive_hash STREQUAL archive_after OR NOT sentinel_hash STREQUAL sentinel_after)
    message(FATAL_ERROR "Existing data was changed or retry bytes differ")
endif()
message(STATUS "CLI overwrite/error/cleanup checks passed; original hashes preserved")
