if(NOT DEFINED HUF_EXECUTABLE OR NOT EXISTS "${HUF_EXECUTABLE}")
    message(FATAL_ERROR "HUF_EXECUTABLE must name the built CLI")
endif()
set(work "${CMAKE_CURRENT_BINARY_DIR}/archive-info-cli")
file(MAKE_DIRECTORY "${work}")
file(REMOVE "${work}/sample.huf")
file(WRITE "${work}/input.txt" "AAAAABBBCC")
execute_process(COMMAND "${HUF_EXECUTABLE}" compress input.txt sample.huf
    WORKING_DIRECTORY "${work}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Fixture compression failed: ${err}")
endif()
file(SHA256 "${work}/sample.huf" before)
file(GLOB files_before RELATIVE "${work}" "${work}/*")
execute_process(COMMAND "${HUF_EXECUTABLE}" info sample.huf
    WORKING_DIRECTORY "${work}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0 OR NOT err STREQUAL "")
    message(FATAL_ERROR "Info failed: ${err}")
endif()
foreach(text IN ITEMS "Archive magic: HUF1" "Archive version: 1" "Original filename: not stored in version 1"
        "Original size: 10 bytes" "Archive size: 59 bytes" "Header size: 57 bytes" "Payload size: 2 bytes"
        "Encoded bits: 15" "Symbol count: 3" "CRC32: present" "not verified by info"
        "0x41=5" "0x42=3" "0x43=2")
    string(FIND "${out}" "${text}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing expected metadata '${text}': ${out}")
    endif()
endforeach()
file(SHA256 "${work}/sample.huf" after)
file(GLOB files_after RELATIVE "${work}" "${work}/*")
if(NOT before STREQUAL after OR NOT files_before STREQUAL files_after)
    message(FATAL_ERROR "Info changed the archive or created output files")
endif()
file(WRITE "${work}/bad.huf" "not an archive")
execute_process(COMMAND "${HUF_EXECUTABLE}" info bad.huf
    WORKING_DIRECTORY "${work}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(result EQUAL 0 OR NOT out STREQUAL "")
    message(FATAL_ERROR "Invalid archive must fail without success metadata")
endif()
message(STATUS "Archive-info CLI checks passed; archive hash and directory entries unchanged")
